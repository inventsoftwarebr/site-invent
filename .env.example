# URL canônica do site — usada em metadata, sitemap, canonical e Open Graph.
# Preview: https://novo.inventsoftware.com.br
# Produção: https://inventsoftware.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Libera a indexação pelos buscadores. SÓ defina como "production" no ambiente
# que serve o domínio oficial. Com qualquer outro valor (ou vazio), o site sai
# com noindex e o robots.txt bloqueia tudo — é o que impede um subdomínio de
# preview de canibalizar o site oficial no Google. Ver docs/deploy.md.
NEXT_PUBLIC_SITE_ENV=

# ---------------------------------------------------------------------------
# Integração do formulário de contato — AINDA NÃO IMPLEMENTADA.
# Hoje app/api/contato/route.ts valida o payload e responde 200 sem encaminhar
# o lead para lugar nenhum. Ao conectar o CRM, as credenciais entram aqui.
# Sem prefixo NEXT_PUBLIC_: são segredos, não podem ir para o browser.
# ---------------------------------------------------------------------------
# HUBSPOT_ACCESS_TOKEN=
# HUBSPOT_FORM_GUID=
# HUBSPOT_PORTAL_ID=
